{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "cd frontend && npm ci && npm run lint && npm run build -- --outDir ../public",
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/chat",
      "methods": [
        "POST",
        "OPTIONS"
      ],
      "dest": "/api/index.py"
    },
    {
      "src": "/chat/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/memory",
      "dest": "/api/index.py"
    },
    {
      "src": "/memory/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(health|docs|openapi.json)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
