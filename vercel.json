{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "fastapi",
  "buildCommand": "cd frontend && npm ci && npm run lint && npm run build -- --outDir ../public",
  "routes": [
    {
      "src": "/(?:|login|register|auth-success|subscription|chat)/?",
      "methods": [
        "GET",
        "HEAD"
      ],
      "dest": "/index.html"
    }
  ]
}
